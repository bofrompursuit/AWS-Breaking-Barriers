# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=

# --- AWS (Amazon Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (ASIA… keys from SSO / hackathon sandboxes):
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Run the agent on Claude via Bedrock instead of the Anthropic API:
# LLM_PROVIDER=bedrock          # Bedrock model default: anthropic.claude-opus-5-5 (verified in us-east-1)

# Optional
# MODEL=claude-opus-5-5
# PORT=3000
