# Copy to .env and fill in. .env is gitignored — never commit real keys.
# All model access goes through Amazon Bedrock (FTUSA requirement). ANTHROPIC_API_KEY is ignored.

# --- AWS (Amazon Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (ASIA… keys from SSO / hackathon sandboxes):
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# MODEL=anthropic.claude-opus-5-5

# --- Access control ---
# Required on any hosted deployment (the app returns 503 until set); optional for local runs.
# DEMO_PASSWORD gates the producer chat; REVIEW_PASSWORD gates /review and the record APIs
# (and also opens the chat). Browsers prompt via HTTP Basic auth; any username works.
DEMO_PASSWORD=
REVIEW_PASSWORD=

# --- Spend guards (optional) ---
# CHAT_RATE_LIMIT=60          # chat turns per IP per 10 minutes
# MAX_TURNS_PER_SESSION=30
# MAX_SESSIONS=500

# Optional
# HOST=127.0.0.1
# PORT=3000
